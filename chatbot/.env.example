# Database (sqlite pour dev local, postgres en prod)
DATABASE_URL=sqlite:///./chatbot.db

# Meta App (developers.facebook.com) — requis pour Embedded Signup
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Token de vérification webhook (chaîne libre choisie par toi)
META_VERIFY_TOKEN=exprex_verify_token_change_me
# Token app / fallback (optionnel si chaque boutique a le sien via Embedded Signup)
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_GRAPH_URL=https://graph.facebook.com

# LLM (optionnel — si absent ou LLM_MOCK=true → réponses mock)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_MOCK=true

# Liens produits Exprex
EXPREX_FRONTEND_URL=https://exprex.vercel.app

# App
APP_NAME=Exprex AI Seller
DEBUG=true
HOST=0.0.0.0
PORT=8001
