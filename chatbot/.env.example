# --- Variables déjà intégrées (ne pas renommer) ---
DATABASE_URL=sqlite:///./chatbot.db

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_MOCK=true

EXPREX_FRONTEND_URL=https://exprex.vercel.app
EXPREX_API_URL=

APP_NAME=Exprex AI Shopping
DEBUG=true
HOST=0.0.0.0
PORT=8001

# --- Optionnel (perf / limites, valeurs par défaut OK) ---
SESSION_TTL_HOURS=72
MAX_HISTORY_MESSAGES=20
CATALOG_CACHE_TTL=60
CATALOG_PROMPT_LIMIT=40
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.4
