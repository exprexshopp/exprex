# Copier ce fichier en backend/.env (ignoré par git) et renseigner les valeurs.
# Sur Vercel : définir les mêmes variables dans Project Settings > Environment Variables.
# NE JAMAIS commiter de vraie valeur.

# --- Obligatoires (le backend refuse de démarrer si elles sont absentes) ---

# Chaîne de connexion SQLAlchemy.
# Exemple local SQLite : sqlite:///./local.db
# Exemple PostgreSQL (Neon) : postgresql://USER:PASSWORD@HOST/DBNAME
DATABASE_URL=

# Secret unique de signature des JWT (HS256). Aucune valeur par défaut.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changer ce secret invalide tous les tokens existants (reconnexion nécessaire).
SECRET_KEY=

# --- Optionnelles ---

# Durée de validité du token d'accès, en minutes (défaut : 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Upload d'images : si vide, repli en data URL base64
# CLOUDINARY_URL=
